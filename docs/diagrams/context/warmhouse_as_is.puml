@startuml
!define C4P https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master
!includeurl C4P/C4_Context.puml

Person(user, "Пользователь", "Владелец дома, управляющий системой через веб-интерфейс")
Person(engineer, "Специалист по установке", "Техник, подключающий устройства к системе")
System_Ext(sensor, "Подключенное устройство", "Измеряет температуру, принимает команды")
System(warmhouse, "Система «Теплый дом»", "Обработка запросов, бизнес-логика, синхронное взаимодействие")
System_Ext(db, "Реляционная БД", "Хранение пользователей, устройств, истории измерений")

Rel(user, warmhouse, "Просматривает и управляет устройствами")
Rel(warmhouse, sensor, "Посылает команды и запрашивает состояние")
Rel(warmhouse, db, "Чтение/запись состояний, истории измерений")
Rel(engineer, sensor, "Регистрирует в системе")
Rel(engineer, warmhouse, "Подключает новое устройство")
@enduml